{
  "dataDir": "/var/lib/sub-bot",
  "shutdownGraceSecs": 10,
  "defaultModel": "gpt-4.1",
  "defaultReasoningEffort": "low",
  "defaultApi": "auto",
  "apiKeyFile": "/etc/sub-bot/openai.key",
  "alerts": {
    "webhookUrl": [
      "https://ops.example.com/sub-bot/issues",
      {
        "url": "https://backup.example.com/sub-bot/issues",
        "secretFile": "/etc/sub-bot/backup-webhook.key",
        "minSeverity": "fatal"
      }
    ],
    "webhookSecretFile": "/etc/sub-bot/alerts-webhook.key",
    "minSeverity": "error",
    "dedupWindowSecs": 60,
    "queueCapacity": 1000
  },
  "profiles": {
    "coder": {
      "model": "gpt-5.4-mini",
      "allowedModels": [
        "gpt-5*",
        "gpt-4.1*"
      ],
      "reasoningEffort": "medium",
      "workspaceRoots": [
        "./work"
      ],
      "appendSystemPrompt": "Run the project's tests after making changes when possible.",
      "allowSystemPromptOverride": true,
      "allowCallerTools": true,
      "api": "auto",
      "shellEnv": {
        "mode": "inherit",
        "deny": [
          "AWS_*",
          "GITHUB_TOKEN"
        ],
        "allow": []
      }
    },
    "reviewer": {
      "model": "gpt-4.1-mini",
      "tools": [
        "preset:readonly"
      ],
      "workspaceRoots": [
        "./work"
      ],
      "appendSystemPrompt": "You only review code. Never modify files.",
      "maxTurns": 25,
      "maxOutputTokens": 8000,
      "tokenBudget": 300000,
      "shellEnv": {
        "mode": "allowlist",
        "allow": [
          "CARGO_HOME",
          "RUSTUP_HOME"
        ]
      }
    },
    "docs-writer": {
      "tools": [
        "preset:no-shell",
        "http_fetch"
      ],
      "httpAllowHosts": [
        "docs.rs",
        "doc.rust-lang.org"
      ],
      "workspaceRoots": [
        "./work/docs"
      ]
    }
  },
  "clients": [
    {
      "name": "ci-bot",
      "tokenSha256": "REPLACE_ME: output of `sub-bot hash-token <a long random token for ci-bot>`",
      "profiles": [
        "reviewer"
      ]
    },
    {
      "name": "dev-bot",
      "webhookSecretFile": "/etc/sub-bot/dev-webhook.key",
      "webhookUrl": [
        "https://dev.example.com/sub-bot/completed",
        {
          "url": "https://dev.example.com/sub-bot/events",
          "secretFile": "/etc/sub-bot/dev-events.key",
          "events": ["task.completed", "task.progress", "issues"],
          "minSeverity": "warn"
        }
      ],
      "tokenSha256": "REPLACE_ME: output of `sub-bot hash-token <a long random token for dev-bot>`",
      "profiles": [
        "coder",
        "reviewer",
        "docs-writer"
      ]
    }
  ]
}
