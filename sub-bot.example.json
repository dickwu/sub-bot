{
  "dataDir": "/var/lib/sub-bot",
  "shutdownGraceSecs": 10,
  "defaultProvider": "openai",
  "defaultModel": "gpt-6.1-sol",
  "defaultReasoningEffort": "high",
  "defaultApi": "auto",
  "apiKeyFile": "/etc/sub-bot/openai.key",
  "providers": {
    "openai": {
      "defaultAccount": "default",
      "failoverCooldownSecs": 60,
      "accounts": {
        "work": {
          "apiKeyFile": "/etc/sub-bot/openai-work.key",
          "organization": "org_REPLACE_ME",
          "project": "proj_REPLACE_ME",
          "fallbackAccounts": ["default"]
        },
        "proxy": {
          "apiKeyEnv": "OPENAI_API_KEY_PROXY",
          "baseUrl": "http://localhost:9000/v1"
        }
      }
    },
    "anthropic": {
      "apiKeyFile": "/etc/sub-bot/anthropic.key",
      "defaultModel": "claude-opus-5-5"
    }
  },
  "alerts": {
    "webhookUrl": [
      "https://ops.example.com/sub-bot/issues",
      {
        "url": "https://backup.example.com/sub-bot/issues",
        "secretFile": "/etc/sub-bot/backup-webhook.key",
        "minSeverity": "fatal"
      }
    ],
    "webhookSecretFile": "/etc/sub-bot/alerts-webhook.key",
    "minSeverity": "error",
    "dedupWindowSecs": 60,
    "queueCapacity": 1000
  },
  "mcpServers": {
    "fs": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "/var/lib/sub-bot/work"],
      "tools": ["read_*", "list_*", "search_files", "get_file_info"]
    },
    "github": {
      "url": "https://api.githubcopilot.com/mcp/",
      "headersFromEnv": {"Authorization": "GITHUB_MCP_AUTHORIZATION"},
      "startupTimeoutSecs": 30,
      "callTimeoutSecs": 120,
      "required": false
    }
  },
  "profiles": {
    "claude": {
      "provider": "anthropic",
      "reasoningEffort": "high",
      "deepModel": "claude-fable-5-1",
      "autoRoute": true,
      "routerModel": "claude-haiku-5-5",
      "workspaceRoots": ["./work"]
    },
    "claude-latest": {
      "provider": "anthropic",
      "model": "claude-sonnet-5-5",
      "deepModel": "latest:claude-fable",
      "workspaceRoots": ["./work"]
    },
    "coder": {
      "model": "gpt-6.1-sol",
      "account": "work",
      "allowedAccounts": ["work", "proxy"],
      "llmMaxRetries": 1,
      "allowedModels": [
        "gpt-6.1-sol",
        "gpt-6-astra"
      ],
      "reasoningEffort": "high",
      "workspaceRoots": [
        "./work"
      ],
      "appendSystemPrompt": "Run the project's tests after making changes when possible.",
      "allowSystemPromptOverride": true,
      "allowCallerTools": true,
      "api": "auto",
      "mcpServers": ["fs", {"name": "github", "tools": ["get_*", "list_*", "search_*"]}],
      "shellEnv": {
        "mode": "inherit",
        "deny": [
          "AWS_*",
          "GITHUB_TOKEN"
        ],
        "allow": []
      },
      "toolApproval": {
        "default": "allow",
        "tools": {
          "bash": "ask",
          "write": "ask",
          "mcp__*": "ask"
        },
        "bash": {
          "allow": ["git status*", "git diff*", "git log*", "ls*", "cargo test*", "cargo build*"],
          "deny": ["rm -rf /*", "sudo *"]
        },
        "timeoutSecs": 300,
        "onTimeout": "deny"
      }
    },
    "reviewer": {
      "model": "gpt-6-astra",
      "tools": [
        "preset:readonly"
      ],
      "workspaceRoots": [
        "./work"
      ],
      "appendSystemPrompt": "You only review code. Never modify files.",
      "maxTurns": 25,
      "maxOutputTokens": 8000,
      "tokenBudget": 300000,
      "shellEnv": {
        "mode": "allowlist",
        "allow": [
          "CARGO_HOME",
          "RUSTUP_HOME"
        ]
      }
    },
    "docs-writer": {
      "tools": [
        "preset:no-shell",
        "http_fetch"
      ],
      "httpAllowHosts": [
        "docs.rs",
        "doc.rust-lang.org"
      ],
      "workspaceRoots": [
        "./work/docs"
      ]
    }
  },
  "clients": [
    {
      "name": "ci-bot",
      "tokenSha256": "REPLACE_ME: output of `sub-bot hash-token <a long random token for ci-bot>`",
      "profiles": [
        "reviewer"
      ]
    },
    {
      "name": "dev-bot",
      "webhookSecretFile": "/etc/sub-bot/dev-webhook.key",
      "webhookUrl": [
        "https://dev.example.com/sub-bot/completed",
        {
          "url": "https://dev.example.com/sub-bot/events",
          "secretFile": "/etc/sub-bot/dev-events.key",
          "events": ["task.completed", "task.progress", "issues"],
          "minSeverity": "warn"
        }
      ],
      "tokenSha256": "REPLACE_ME: output of `sub-bot hash-token <a long random token for dev-bot>`",
      "profiles": [
        "coder",
        "claude",
        "claude-latest",
        "reviewer",
        "docs-writer"
      ]
    }
  ]
}
